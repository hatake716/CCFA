<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Google Play 版（google-play ブランチ）の権限セット。

      sideload 版が使っていた MANAGE_EXTERNAL_STORAGE（全ファイルアクセス）は
      Play の制限付き権限で、汎用ターミナル用途では審査に通らないため撤去した。
      READ/WRITE_EXTERNAL_STORAGE と requestLegacyExternalStorage も targetSdk 36 では
      無効（scoped storage 強制）なので削除している。

      Linux コンテナの rootfs・PRoot・HOME・/workspace はすべてアプリ専用領域
      (Context.filesDir) に置くため、ストレージ権限は不要。
      Android 側フォルダとの共有は SAF(ACTION_OPEN_DOCUMENT_TREE) で
      ユーザーが選んだツリーのみに限定する（実装は TODO / docs/PLAY-RELEASE.md 参照）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".EmbeddedTerminalActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".ContainerManagerActivity"
            android:exported="false" />

        <activity
            android:name=".StorageSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".LegalActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
